# Required only for deployment; set a unique random value.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
PORT=5000
LOG_LEVEL=INFO

# AWS credentials should come from an EC2 instance role, not hardcoded keys.
AWS_REGION=us-east-1
S3_BUCKET=
SQS_QUEUE_URL=
SNS_TOPIC_ARN=

# Optional CloudWatch Logs integration. Create/authorize the log group or allow the app role to create it.
CLOUDWATCH_LOG_GROUP=
CLOUDWATCH_LOG_STREAM=cloud-incident-reporter
